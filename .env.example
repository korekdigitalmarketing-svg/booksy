# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only — never imported into a client component

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Cron
CRON_SECRET=

# Google Calendar sync (Phase 1: import-only)
# https://console.cloud.google.com — enable the Calendar API, configure the
# OAuth consent screen, create a Web application OAuth client. Authorized
# redirect URI must be {NEXT_PUBLIC_APP_URL}/api/calendar/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any random string — a shared secret echoed back on every Google push
# notification (X-Goog-Channel-Token) so the webhook route can tell a real
# Google request apart from anyone who finds the (necessarily public) URL.
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Microsoft/Outlook Calendar sync (Phase 1: import-only)
# https://entra.microsoft.com — App registrations > New registration. Add a
# Web platform redirect URI of {NEXT_PUBLIC_APP_URL}/api/calendar/microsoft/callback
# and a client secret under Certificates & secrets. No API permissions need
# granting up front — Calendars.Read (delegated) is requested at consent time.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Any random string — Graph's equivalent of GOOGLE_CALENDAR_WEBHOOK_TOKEN
# above, sent back as `clientState` in the JSON body of every Graph change
# notification rather than a header.
MICROSOFT_CALENDAR_WEBHOOK_TOKEN=
